    {
      "parameters": {
        "jsCode": "const searchQuery = $(\"When Executed by Another Workflow\")\n  .first()\n  .json\n  .search_query\n  ?.toLowerCase()\n  .trim();\n\nconst maxPrice = Number(\n  $(\"When Executed by Another Workflow\")\n    .first()\n    .json\n    .max_price\n);\n\nconst products = $input.all();\n\nconst results = products.filter(item => {\n  const p = item.json;\n\n  const text = [\n    p.product_name,\n    p.category,\n    p.description\n  ]\n    .filter(Boolean)\n    .join(\" \")\n    .toLowerCase();\n\n  const matchesSearch =\n    !searchQuery || text.includes(searchQuery);\n\n  const matchesPrice =\n    !maxPrice || Number(p.price) <= maxPrice;\n\n  return matchesSearch && matchesPrice;\n});\n\nreturn results;"
      },
