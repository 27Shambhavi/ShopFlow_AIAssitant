    {
      "parameters": {
        "jsCode": "const input = $(\"When Executed by Another Workflow\").first().json;\n\nconst productId = input.product_id;\nconst requestedQuantity = Number(input.quantity);\n\nconst products = $input.all();\n\nconst product = products.find(\n  item => item.json.product_id === productId\n);\n\nif (!product) {\n  return [{\n    json: {\n      success: false,\n      status: \"PRODUCT_NOT_FOUND\",\n      message: `Product ${productId} was not found.`\n    }\n  }];\n}\n\nconst stock = Number(product.json.stock);\n\nif (requestedQuantity <= 0) {\n  return [{\n    json: {\n      success: false,\n      status: \"INVALID_QUANTITY\",\n      message: \"Quantity must be greater than 0.\"\n    }\n  }];\n}\n\nif (requestedQuantity > stock) {\n  return [{\n    json: {\n      success: false,\n      status: \"INSUFFICIENT_STOCK\",\n      product_id: productId,\n      product_name: product.json.product_name,\n      requested_quantity: requestedQuantity,\n      available_stock: stock,\n      message: `Only ${stock} units are available.`\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    success: true,\n    status: \"STOCK_AVAILABLE\",\n    product_id: productId,\n    product_name: product.json.product_name,\n    price: Number(product.json.price),\n    requested_quantity: requestedQuantity,\n    available_stock: stock,\n    customer_name: input.customer_name,\n    customer_email: input.customer_email\n  }\n}];"
      },
